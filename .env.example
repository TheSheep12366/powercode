# PowerCode 环境配置模板 —— 复制为 .env 后按需修改
# :: = 双栈（IPv4+IPv6）；0.0.0.0 = 仅 IPv4；127.0.0.1 = 仅本机（生产走 Nginx 反代时用这个）
PORT=3100
HOST=::

# 数据目录（SQLite、后续密钥等）
DATA_DIR=data

# 会话
SESSION_TTL_DAYS=7
# 生产启用 HTTPS 后改为 true
COOKIE_SECURE=false
# Nginx 本机反代时填 loopback，直连时留空或填 0
TRUST_PROXY=loopback

# 初始管理员（仅在用户表为空时创建一次；不填则生成随机密码并打印到启动日志）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# 共享工作区根目录（生产可自定义）
WORKSPACES_ROOT=/www/wwwroot/collab-workspaces

# 本机 sshd（后续 Web 终端用）
SSH_HOST=127.0.0.1
SSH_PORT=22

LOG_LEVEL=info
